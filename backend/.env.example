# Copy to backend/.env and fill in. Values match what the deployed service uses,
# so the quickest source is the Render dashboard → Environment.

PORT=5000
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/pinned
JWT_SECRET=any-long-random-string-for-local-use
CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

GEMINI_API_KEY=your_gemini_api_key
